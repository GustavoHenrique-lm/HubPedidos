
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HubPedidos": "Server=.\\SQLEXPRESS;Database=HubPedidosDb;Trusted_Connection=True;TrustServerCertificate=True"
